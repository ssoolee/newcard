# Deploy-time values for the params declared in functions/src.
#
# GEMINI_MODEL has a default in code, but `firebase deploy` in a
# non-interactive shell (CI, or an agent) refuses to assume it, so the
# value is pinned here. This file holds configuration only — the one
# real secret, GEMINI_API_KEY, lives in Secret Manager and must never
# be written here.
GEMINI_MODEL=gemini-2.5-flash
