# Copy to `.env.local` and fill from the Firebase console
# (Project settings → General → Your apps → SDK setup and configuration).
#
# These values are public by design — they identify the project, they do not
# authorize anything. Access is controlled by App Check, Firebase Auth and the
# Firestore security rules. The one real secret, the Gemini API key, lives in
# Secret Manager and never appears in this file or in the client bundle.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=

# App Check → reCAPTCHA Enterprise key ID (Firebase console → App Check → Apps).
# Enterprise keys have no secret half: this key ID is the whole registration.
VITE_RECAPTCHA_SITE_KEY=
